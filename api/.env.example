# Copy to .env and fill in. Never commit the real .env.

# Gemini (server-side only). Leave blank to run in stub/demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# External geocoding fallback (OpenStreetMap Nominatim).
ENABLE_NOMINATIM=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SafePulse/0.1
NOMINATIM_CONTACT_EMAIL=you@example.com
NOMINATIM_MIN_INTERVAL_SECONDS=1.0

# Database
DATABASE_URL=sqlite:///./safepulse.db

# CORS: allowed origins for the web app (comma-separated)
CORS_ORIGINS=http://localhost:3000
